# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.
# In Google Colab you do not need this file - use the key cell in the notebook instead.

# --- Required -----------------------------------------------------------
# Get a free key at https://console.groq.com/keys  (no credit card)
LLM_API_KEY=

# --- Provider wiring ----------------------------------------------------
# Defaults below are for Groq. To switch provider, change all three.
# Any OpenAI-compatible /chat/completions endpoint works unchanged.
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Leave LLM_MODEL blank to let the lab ask the provider what is available and
# pick the best one. Set it only to force a specific model.
#   python labkit.py     lists every model your key can use
LLM_MODEL=

# Alternatives, both free tier, both OpenAI-compatible:
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions
#   Together    https://api.together.xyz/v1/chat/completions
